  {
    "name": "t:settings.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography_headings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "t:settings.font_heading",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings.heading_scale",
        "min": 90,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_transform",
        "label": "t:settings.heading_transform",
        "options": [
          { "value": "none", "label": "t:settings.transform_none" },
          { "value": "uppercase", "label": "t:settings.transform_uppercase" }
        ],
        "default": "uppercase"
      },
      {
        "type": "header",
        "content": "t:settings.typography_body"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings.font_body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings.body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings.layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "t:settings.spacing_sections",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "t:settings.grid_gap",
        "min": 4,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "t:settings.buttons_cards",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.buttons"
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "t:settings.button_border_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "button_uppercase",
        "label": "t:settings.button_uppercase",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings.cards"
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "label": "t:settings.card_border_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "card_shadow",
        "label": "t:settings.card_shadow",
        "default": false
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings.card_image_ratio",
        "options": [
          { "value": "portrait", "label": "t:settings.ratio_portrait" },
          { "value": "square", "label": "t:settings.ratio_square" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "t:settings.header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings.logo_width",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "t:settings.sticky_header",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.favicon"
      }
    ]
  },
  {
    "name": "t:settings.social",
    "settings": [
      { "type": "header", "content": "t:settings.social_accounts" },
      { "type": "text", "id": "social_instagram", "label": "Instagram", "placeholder": "https://instagram.com/tu-tienda" },
      { "type": "text", "id": "social_facebook", "label": "Facebook", "placeholder": "https://facebook.com/tu-tienda" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok", "placeholder": "https://tiktok.com/@tu-tienda" },
      { "type": "text", "id": "social_youtube", "label": "YouTube", "placeholder": "https://youtube.com/@tu-tienda" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest", "placeholder": "https://pinterest.com/tu-tienda" },
      { "type": "text", "id": "social_twitter", "label": "X / Twitter", "placeholder": "https://x.com/tu-tienda" }
    ]
  },
  {
    "name": "t:settings.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart_type",
        "options": [
          { "value": "drawer", "label": "t:settings.cart_type_drawer" },
          { "value": "page", "label": "t:settings.cart_type_page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_shipping_note",
        "label": "t:settings.cart_show_shipping_note",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_shipping_note",
        "label": "t:settings.cart_shipping_note_text",
        "default": "Envío gratis en pedidos superiores a 50€"
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "t:settings.cart_free_shipping_threshold",
        "default": 50
      }
    ]
  },
  {
    "name": "t:settings.search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "t:settings.predictive_search_enabled",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_vendor",
        "label": "t:settings.predictive_search_show_vendor",
        "default": false
      }
    ]
  }
]
