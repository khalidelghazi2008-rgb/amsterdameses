<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_header_background }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ 'general.search.tags' | t }} {{ current_tags | join: ', ' }}{% endif %}
    {%- if current_page != 1 %} &ndash; {{ 'general.pagination.current_page' | t: current: current_page, total: paginate.pages }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- comment -%} Open Graph {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio }}">
  {%- endif -%}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}<meta name="twitter:description" content="{{ page_description | escape }}">{%- endif -%}

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if settings.logo -%}
      ,"logo": {{ settings.logo | image_url: width: 300 | prepend: "https:" | json }}
      {%- endif -%}
      {%- assign social_links = '' -%}
      {%- capture social_links -%}
        {%- if settings.social_instagram != blank -%}"{{ settings.social_instagram }}",{%- endif -%}
        {%- if settings.social_facebook != blank -%}"{{ settings.social_facebook }}",{%- endif -%}
        {%- if settings.social_tiktok != blank -%}"{{ settings.social_tiktok }}",{%- endif -%}
        {%- if settings.social_youtube != blank -%}"{{ settings.social_youtube }}",{%- endif -%}
        {%- if settings.social_pinterest != blank -%}"{{ settings.social_pinterest }}",{%- endif -%}
        {%- if settings.social_twitter != blank -%}"{{ settings.social_twitter }}"{%- endif -%}
      {%- endcapture -%}
      {%- assign social_links = social_links | strip_newlines | strip -%}
      {%- if social_links != blank -%}
      ,"sameAs": [{{ social_links | remove: ',,' }}]
      {%- endif -%}
    }
  </script>

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    :root {
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-text-subdued: {{ settings.color_text | color_mix: settings.color_background, 55 }};
      --color-border: {{ settings.color_border }};
      --color-surface: {{ settings.color_surface }};
      --color-button-background: {{ settings.color_button_background }};
      --color-button-text: {{ settings.color_button_text }};
      --color-secondary-background: {{ settings.color_secondary_background }};
      --color-secondary-text: {{ settings.color_secondary_text }};
      --color-sale: {{ settings.color_sale }};
      --color-new: {{ settings.color_new }};
      --color-success: {{ settings.color_success }};
      --color-header-background: {{ settings.color_header_background }};
      --color-header-text: {{ settings.color_header_text }};
      --color-announcement-background: {{ settings.color_announcement_background }};
      --color-announcement-text: {{ settings.color_announcement_text }};
      --color-footer-background: {{ settings.color_footer_background }};
      --color-footer-text: {{ settings.color_footer_text }};

      --font-heading-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-heading-weight: {{ settings.font_heading.weight }};
      --font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-body-weight: {{ settings.font_body.weight }};
      --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
      --heading-transform: {{ settings.heading_transform }};

      --page-width: {{ settings.page_width }}px;
      --spacing-sections: {{ settings.spacing_sections }}px;
      --grid-gap: {{ settings.grid_gap }}px;

      --button-radius: {{ settings.button_border_radius }}px;
      --button-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
      --card-radius: {{ settings.card_border_radius }}px;
      --logo-width: {{ settings.logo_width }}px;
    }
    h1 { font-size: calc(2.75rem * {{ settings.heading_scale | divided_by: 100.0 }}); }
    h2 { font-size: calc(2rem * {{ settings.heading_scale | divided_by: 100.0 }}); }
    h3 { font-size: calc(1.5rem * {{ settings.heading_scale | divided_by: 100.0 }}); }
  {%- endstyle -%}

  {{ content_for_header }}
</head>

<body
  class="template-{{ request.page_type | handleize }}"
  data-cart-type="{{ settings.cart_type }}"
>
  <a class="skip-to-content-link button visually-hidden" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  <script>
    window.themeStrings = {
      cartError: {{ 'general.cart.error' | t | json }},
      searchProducts: {{ 'general.search.products' | t | json }},
      searchCollections: {{ 'general.search.collections' | t | json }},
      searchPages: {{ 'general.search.pages' | t | json }},
      searchArticles: {{ 'general.search.articles' | t | json }},
      noResultsTemplate: {{ 'general.search.no_results' | t: terms: '__TERM__' | json }}
    };
    window.themeRoutes = {
      cart_url: {{ routes.cart_url | json }},
      cart_add_url: {{ routes.cart_add_url | json }},
      cart_change_url: {{ routes.cart_change_url | json }},
      predictive_search_url: {{ routes.predictive_search_url | json }}
    };
    window.themeSettings = { moneyFormat: {{ shop.money_format | json }} };
    document.documentElement.classList.replace('no-js', 'js');
  </script>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
