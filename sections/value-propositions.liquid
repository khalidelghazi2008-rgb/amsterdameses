{%- comment -%}
  3-4 column value proposition strip (quality, secure payment, fast
  shipping, customer support...). Icon, title and text are all editable
  per block.
{%- endcomment -%}

<section class="section section--tight" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-header__title visually-center" style="margin-bottom:2rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="grid value-props__grid">
      {%- for block in section.blocks -%}
        <div class="value-prop" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, class: 'icon value-prop__icon' %}
          <p class="value-prop__title">{{ block.settings.title }}</p>
          <p class="value-prop__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Propuestas de valor",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Por qué comprar con nosotros" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Propuesta de valor",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "shield", "label": "Escudo" },
            { "value": "lock", "label": "Candado" },
            { "value": "truck", "label": "Camión" },
            { "value": "return", "label": "Devolución" },
            { "value": "headset", "label": "Auriculares" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Estrella" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Calidad garantizada" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Materiales seleccionados y control de calidad en cada prenda." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Propuestas de valor",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "title": "Calidad garantizada", "text": "Materiales seleccionados y control de calidad en cada prenda." } },
        { "type": "item", "settings": { "icon": "lock", "title": "Pago seguro", "text": "Todas las transacciones están cifradas y protegidas." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Envío rápido", "text": "Preparamos tu pedido en menos de 24-48h." } },
        { "type": "item", "settings": { "icon": "headset", "title": "Atención al cliente", "text": "Resolvemos tus dudas antes y después de la compra." } }
      ]
    }
  ]
}
{% endschema %}
