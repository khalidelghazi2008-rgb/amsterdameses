<div id="stories-bar" style="background:#0d0d0d; padding:16px 10px; display:flex; gap:18px; overflow-x:auto; -webkit-overflow-scrolling:touch; border-bottom:1px solid #1a1a1a;">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; flex-shrink:0; width:70px;" {{ block.shopify_attributes }}>
      <div class="story-ring">
        <div class="story-avatar">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 120 }}" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
          {% else %}
            <span style="color:#ffffff; font-size:22px;">+</span>
          {% endif %}
        </div>
      </div>
      <span style="color:#ffffff; font-size:11px; font-weight:600; text-transform:uppercase; margin-top:6px; text-align:center;">{{ block.settings.label }}</span>
    </a>
  {% endfor %}
</div>

<style>
  #stories-bar::-webkit-scrollbar { display: none; }
  #stories-bar { scrollbar-width: none; }

  .story-ring {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #0057D9, #66B2FF, #0057D9, #001f4d, #0057D9);
    animation: story-spin 2.5s linear infinite;
    box-shadow: 0 0 12px 2px rgba(0, 87, 217, 0.8);
  }

  .story-avatar {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #0d0d0d;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    overflow: hidden;
  }

  @keyframes story-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

{% schema %}
{
  "name": "Historias productos",
  "settings": [],
  "blocks": [
    {
      "type": "story",
      "name": "Historia",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "label", "label": "Texto debajo", "default": "Producto" },
        { "type": "url", "id": "link", "label": "Enlace (elige producto o colección)" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Historias productos",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}