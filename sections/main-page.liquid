{%- comment -%} Generic content page (About, Contact, policies fallback, etc). {%- endcomment -%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width" style="max-width:820px;">
    {% render 'breadcrumbs' %}
    <h1 class="collection-header__title" style="margin-bottom:1.5rem;">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Página"
}
{% endschema %}
