{%- comment -%}
  Premium ecommerce header: logo, horizontal nav with mega menu (desktop),
  hamburger + drawer nav (mobile), search / account / cart icons with a
  live cart count bubble. Navigation comes 100% from a Shopify menu
  (Online Store > Navigation) — nothing here is hardcoded.
{%- endcomment -%}

{%- liquid
  assign main_menu = section.settings.menu
  assign sticky = settings.sticky_header
-%}

<div class="header-wrapper{% if sticky %} is-sticky{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="header">
      <button type="button" class="header__icon-btn header__menu-toggle" data-drawer-open="MobileMenuDrawer" aria-label="{{ 'general.icons.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>

      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if settings.logo -%}
          <img
            src="{{ settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width }}"
            height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>

      <nav class="header__nav" aria-label="{{ 'general.icons.menu' | t }}">
        {%- for link in main_menu.links -%}
          <div class="nav__item">
            <a href="{{ link.url }}" class="nav__link">
              {{ link.title }}
              {%- if link.links != blank -%}{% render 'icon', name: 'chevron-down' %}{%- endif -%}
            </a>

            {%- if link.links != blank -%}
              {%- assign has_grandchildren = false -%}
              {%- for sublink in link.links -%}
                {%- if sublink.links != blank -%}{%- assign has_grandchildren = true -%}{%- endif -%}
              {%- endfor -%}

              {%- assign promo_block = nil -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'promo' and block.settings.menu_item_title == link.title -%}
                  {%- assign promo_block = block -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if has_grandchildren or promo_block -%}
                <div class="mega-menu mega-menu--full">
                  {%- for sublink in link.links -%}
                    <div class="mega-menu__col">
                      <p class="mega-menu__col-title">
                        <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                      </p>
                      {%- if sublink.links != blank -%}
                        {%- for grandchild in sublink.links -%}
                          <a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a>
                        {%- endfor -%}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}

                  {%- if promo_block -%}
                    <div class="mega-menu__col mega-menu__promo" {{ promo_block.shopify_attributes }}>
                      {%- if promo_block.settings.image -%}
                        {% render 'responsive-image', image: promo_block.settings.image, sizes: '260px' %}
                      {%- endif -%}
                      {%- if promo_block.settings.heading != blank -%}
                        <p class="mega-menu__promo-title">{{ promo_block.settings.heading }}</p>
                      {%- endif -%}
                      {%- if promo_block.settings.button_label != blank -%}
                        <a href="{{ promo_block.settings.button_link }}" class="link-underline">{{ promo_block.settings.button_label }}</a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="dropdown-menu">
                  {%- for sublink in link.links -%}
                    <a href="{{ sublink.url }}" class="dropdown-menu__link">{{ sublink.title }}</a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>

      <div class="header__icons">
        <button type="button" class="header__icon-btn" data-drawer-open="SearchDrawer" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="header__icon-btn" aria-label="{{ 'general.icons.account' | t }}">
            {% render 'icon', name: 'account' %}
          </a>
        {%- endif -%}

        {%- if settings.cart_type == 'drawer' -%}
          <button type="button" class="header__icon-btn" data-drawer-open="CartDrawer" aria-label="{{ 'general.icons.cart' | t }}">
            {% render 'icon', name: 'cart' %}
            <span class="header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
          </button>
        {%- else -%}
          <a href="{{ routes.cart_url }}" class="header__icon-btn" aria-label="{{ 'general.icons.cart' | t }}">
            {% render 'icon', name: 'cart' %}
            <span class="header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div id="MobileMenuDrawer" class="drawer drawer--left" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ 'general.icons.menu' | t }}" hidden>
  <div class="drawer__header">
    <span class="header__logo">{{ shop.name }}</span>
    <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <div class="drawer__body">
    <ul class="mobile-nav">
      {%- for link in main_menu.links -%}
        <li class="mobile-nav__item">
          {%- if link.links != blank -%}
            <button type="button" class="mobile-nav__link" data-mobile-nav-toggle>
              {{ link.title }}
              {% render 'icon', name: 'chevron-down' %}
            </button>
            <ul class="mobile-nav__sublist">
              {%- for sublink in link.links -%}
                <li><a href="{{ sublink.url }}" class="mobile-nav__sublink">{{ sublink.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <div class="drawer__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="button button--secondary button--full">{{ 'general.icons.account' | t }}</a>
    {%- endif -%}
  </div>
</div>
<div class="drawer-overlay" data-drawer-overlay="MobileMenuDrawer"></div>

{%- comment -%} Search drawer with predictive search {%- endcomment -%}
<div id="SearchDrawer" class="drawer drawer--right search-drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ 'general.search.search' | t }}" hidden>
  <div class="drawer__header">
    <h2 class="drawer__title">{{ 'general.search.search' | t }}</h2>
    <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <div class="drawer__body">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="field">
        <label class="visually-hidden" for="SearchDrawerInput">{{ 'general.search.search' | t }}</label>
        <input
          type="search"
          name="q"
          id="SearchDrawerInput"
          class="field__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          {% if settings.predictive_search_enabled %}data-predictive-search-input{% endif %}
        >
        <input type="hidden" name="type" value="product">
      </div>
    </form>

    {%- if settings.predictive_search_enabled -%}
      <p data-predictive-search-idle class="text-subdued" style="font-size:.85rem;">{{ 'general.search.placeholder' | t }}</p>
      <div data-predictive-search-empty hidden class="empty-state">
        <p class="empty-state__title" data-search-term></p>
        <p class="empty-state__text">{{ 'general.search.no_results_helper' | t }}</p>
      </div>
      <div class="predictive-search__results" data-predictive-search-results hidden></div>
    {%- endif -%}
  </div>
</div>
<div class="drawer-overlay" data-drawer-overlay="SearchDrawer"></div>

{% schema %}
{
  "name": "Cabecera",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Destacado de menú",
      "settings": [
        { "type": "text", "id": "menu_item_title", "label": "Título exacto del elemento del menú al que pertenece", "info": "Debe coincidir con el texto de un enlace de primer nivel del menú." },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "text", "id": "button_label", "label": "Texto del enlace" },
        { "type": "url", "id": "button_link", "label": "Enlace" }
      ]
    }
  ]
}
{% endschema %}
