{%- comment -%} 404 error page. {%- endcomment -%}

<section class="section" style="text-align:center;" {{ section.shopify_attributes }}>
  <div class="page-width">
    <h1 class="collection-header__title">{{ '404.title' | t }}</h1>
    <p class="text-subdued" style="margin: 1rem 0 2rem;">{{ '404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="button">{{ '404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Página 404"
}
{% endschema %}
