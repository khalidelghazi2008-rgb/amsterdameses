{% comment %}
  Página de Wishlist ("favoritos"). Como Shopify no ofrece wishlist nativa,
  el contenido se pinta 100% en el cliente (assets/wishlist-page.js) a
  partir de los handles guardados en localStorage por assets/wishlist.js.
  El título y los textos del estado vacío son configurables desde el editor.
{% endcomment %}

{{ 'amstershop-js-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'amstershop-client-cards.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'wishlist-page.js' | asset_url }}" defer="defer"></script>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding"
    data-amstershop-wishlist-page
  >
    <div class="title-wrapper-with-link title-wrapper--no-top-margin">
      <h1 class="title {{ section.settings.heading_size }}">
        {{ section.settings.heading | default: 'Tu Wishlist' }}
      </h1>
    </div>

    <p data-wishlist-loading class="amstershop-empty-state__text" hidden>
      {{ 'accessibility.loading' | t }}
    </p>

    <ul class="amstershop-js-card-grid" role="list" hidden></ul>

    <div class="amstershop-empty-state" hidden>
      <h2>
        {%- if section.settings.empty_heading != blank -%}
          {{ section.settings.empty_heading }}
        {%- else -%}
          {{ 'amstershop.wishlist.empty_heading' | t }}
        {%- endif -%}
      </h2>
      <div class="amstershop-empty-state__text rte">
        {%- if section.settings.empty_text != blank -%}
          {{ section.settings.empty_text }}
        {%- else -%}
          {{ 'amstershop.wishlist.empty_text' | t }}
        {%- endif -%}
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'amstershop.wishlist.continue_shopping' | t }}
      </a>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tu Wishlist"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Título (wishlist vacía)"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "Texto (wishlist vacía)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
