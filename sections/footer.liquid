{%- comment -%}
  Footer: configurable columns (menus or rich text) via blocks, newsletter
  signup, social icons, payment icons and shop policy links.
{%- endcomment -%}

<footer class="footer" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__block footer__newsletter">
        {%- if section.settings.show_newsletter -%}
          <p class="footer__block-title">{{ section.settings.newsletter_heading }}</p>
          <p style="font-size:.85rem;margin-bottom:1rem;opacity:.8;">{{ section.settings.newsletter_text }}</p>
          {%- form 'customer', id: 'FooterNewsletterForm', data-newsletter-form: '' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="field" style="display:flex;gap:.5rem;">
              <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
              <input type="email" name="contact[email]" id="FooterNewsletterEmail" class="field__input" placeholder="{{ 'newsletter.placeholder' | t }}" required>
              <button type="submit" class="button" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p data-newsletter-success class="footer__newsletter-success" style="font-size:.8rem;margin-top:.5rem;">{{ 'newsletter.confirmation' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
            {%- if settings.social_twitter != blank -%}<a href="{{ settings.social_twitter }}" aria-label="X">{% render 'icon', name: 'twitter' %}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="footer__block" {{ block.shopify_attributes }}>
              <p class="footer__block-title">{{ block.settings.heading }}</p>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'policies' -%}
            <div class="footer__block" {{ block.shopify_attributes }}>
              <p class="footer__block-title">{{ block.settings.heading }}</p>
              <ul class="footer__list">
                {%- if shop.policies.privacy_policy != blank -%}<li><a href="{{ shop.policies.privacy_policy.url }}">{{ shop.policies.privacy_policy.title }}</a></li>{%- endif -%}
                {%- if shop.policies.refund_policy != blank -%}<li><a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title }}</a></li>{%- endif -%}
                {%- if shop.policies.shipping_policy != blank -%}<li><a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title }}</a></li>{%- endif -%}
                {%- if shop.policies.terms_of_service != blank -%}<li><a href="{{ shop.policies.terms_of_service.url }}">{{ shop.policies.terms_of_service.title }}</a></li>{%- endif -%}
                {%- if shop.policies.subscription_policy != blank -%}<li><a href="{{ shop.policies.subscription_policy.url }}">{{ shop.policies.subscription_policy.title }}</a></li>{%- endif -%}
                <li><button type="button" class="footer__list-btn" style="background:none;border:none;color:inherit;padding:0;text-align:left;font-size:inherit;opacity:.85;" onclick="window.Shopify && Shopify.OSCookieBanner && Shopify.OSCookieBanner.toggle && Shopify.OSCookieBanner.toggle()">{{ block.settings.cookie_prefs_label }}</button></li>
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="footer__block" {{ block.shopify_attributes }}>
              <p class="footer__block-title">{{ block.settings.heading }}</p>
              <div class="rte" style="font-size:.88rem;opacity:.85;">{{ block.settings.content }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      <p>{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</p>

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Título newsletter", "default": "Newsletter" },
    { "type": "text", "id": "newsletter_text", "label": "Texto newsletter", "default": "Suscríbete y no te pierdas nada." },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociales", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    },
    {
      "type": "policies",
      "name": "Políticas",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Políticas" },
        { "type": "text", "id": "cookie_prefs_label", "label": "Texto de preferencias de cookies", "default": "Preferencias de cookies" }
      ]
    },
    {
      "type": "text",
      "name": "Texto / Contacto",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Contacto" },
        { "type": "richtext", "id": "content", "label": "Contenido" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Tienda" } },
        { "type": "link_list", "settings": { "heading": "Ayuda" } },
        { "type": "policies" }
      ]
    }
  ]
}
{% endschema %}
