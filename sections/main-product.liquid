{%- comment -%}
  Product detail page. Desktop: sticky gallery left, info right. Mobile:
  gallery on top, sticky add-to-cart bar once the main CTA scrolls out of
  view. Ships with Product + Breadcrumb JSON-LD for SEO.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    {% render 'breadcrumbs' %}

    <div class="product">
      <div class="product__gallery">
        <div class="product__gallery-main">
          {%- if current_variant.featured_media -%}
            {% render 'responsive-image', image: current_variant.featured_media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high' %}
          {%- elsif product.featured_media -%}
            {% render 'responsive-image', image: product.featured_media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high' %}
          {%- else -%}
            {% render 'responsive-image', image: nil, aspect_ratio: '4/5' %}
          {%- endif -%}
        </div>

        {%- if media_count > 1 -%}
          <div class="product__gallery-thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product__gallery-thumb{% if forloop.first %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-full-src="{{ media.preview_image | image_url: width: 1200 }}"
                aria-label="{{ 'products.product.view_details' | t }} {{ forloop.index }}"
              >
                <img src="{{ media.preview_image | image_url: width: 150 }}" alt="{{ media.alt | escape }}" width="64" height="80" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if section.settings.show_vendor -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__price-row">
          {% render 'price', product: product, show_discount: true %}
          {%- if section.settings.show_sku -%}
            <span class="text-subdued" style="font-size:.8rem;" data-product-sku>{{ current_variant.sku }}</span>
          {%- endif -%}
        </div>

        <div class="product__availability{% unless current_variant.available %} product__availability--out{% endunless %}"
             data-product-availability
             data-in-stock-text="{{ 'products.product.availability_in_stock' | t }}"
             data-out-stock-text="{{ 'products.product.availability_out_of_stock' | t }}">
          <span class="product__availability-dot"></span>
          <span data-availability-text>
            {%- if current_variant.available -%}{{ 'products.product.availability_in_stock' | t }}{%- else -%}{{ 'products.product.availability_out_of_stock' | t }}{%- endif -%}
          </span>
        </div>

        <div data-atc-anchor>
          {% render 'product-form', product: product, show_buy_now: section.settings.show_buy_now %}
        </div>

        {%- if section.settings.show_shipping_info -%}
          <div class="product__shipping-info">
            {% render 'icon', name: 'truck' %}
            <span>{{ 'products.product.shipping_returns_content' | t }}</span>
          </div>
        {%- endif -%}

        <div class="product__accordions">
          {%- if product.description != blank -%}
            <details class="accordion-item" open>
              <summary class="accordion-item__trigger">
                <span>{{ 'products.product.description' | t }}</span>
                <span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="accordion-item__panel rte">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- if section.settings.show_shipping_info -%}
            <details class="accordion-item">
              <summary class="accordion-item__trigger">
                <span>{{ 'products.product.shipping_returns' | t }}</span>
                <span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="accordion-item__panel rte">{{ 'products.product.shipping_returns_content' | t }}</div>
            </details>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="accordion-item" {{ block.shopify_attributes }}>
                <summary class="accordion-item__trigger">
                  <span>{{ block.settings.title }}</span>
                  <span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span>
                </summary>
                <div class="accordion-item__panel rte">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_share -%}
          <div class="product__share" style="margin-top:1rem;">
            <a class="link-underline" style="font-size:.82rem;" href="https://www.instagram.com/share?url={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">
              {{ 'products.product.share' | t }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.show_related and recommendations.performed and recommendations.products_count > 0 -%}
  <section class="section related-products">
    <div class="page-width">
      <div class="section-header">
        <h2 class="section-header__title">{{ 'products.product.related_products' | t }}</h2>
      </div>
      <div class="grid card-grid card-grid--4">
        {%- for related_product in recommendations.products limit: section.settings.related_count -%}
          {% render 'product-card', product: related_product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} Sticky add-to-cart bar (mobile only) {%- endcomment -%}
<div class="sticky-atc">
  <div class="sticky-atc__info">
    <p class="sticky-atc__title">{{ product.title }}</p>
    {% render 'price', product: product %}
  </div>
  <button type="button" class="button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
  </button>
</div>

{%- if recommendations.performed == false -%}
  <script src="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.related_count }}" defer></script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ product.description | strip_html | json }},
  "sku": {{ current_variant.sku | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- if product.featured_image -%}
  "image": [{{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}],
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current_variant.price | money_without_currency | remove: ',' | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Página de producto",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": true },
    { "type": "checkbox", "id": "show_sku", "label": "Mostrar SKU", "default": false },
    { "type": "checkbox", "id": "show_buy_now", "label": "Mostrar \"Comprar ahora\"", "default": true },
    { "type": "checkbox", "id": "show_shipping_info", "label": "Mostrar información de envío", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Mostrar compartir", "default": true },
    { "type": "checkbox", "id": "show_related", "label": "Mostrar productos relacionados", "default": true },
    { "type": "range", "id": "related_count", "label": "Número de productos relacionados", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Acordeón personalizado",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Guía de tallas" },
        { "type": "richtext", "id": "content", "label": "Contenido" }
      ]
    }
  ]
}
{% endschema %}
