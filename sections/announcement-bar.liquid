{%- comment -%} Rotating top announcement bar. Colors come from theme settings; each message is an editable block. {%- endcomment -%}

{%- if section.settings.enable and section.blocks.size > 0 -%}
  <div class="announcement-bar" {{ section.shopify_attributes }}>
    <div class="announcement-bar__wrapper">
      {%- for block in section.blocks -%}
        <div class="announcement-bar__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- if section.settings.dismissible -%}
        <button type="button" class="announcement-bar__close" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Mostrar barra de anuncios", "default": true },
    { "type": "checkbox", "id": "dismissible", "label": "Permitir cerrar", "default": false }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "ENVÍO GRATIS EN TODOS LOS PEDIDOS" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
