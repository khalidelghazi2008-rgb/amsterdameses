{%- comment -%}
  Newsletter signup, wired to Shopify's native customer form (creates a
  subscribed customer / marketing lead — no external app required).
{%- endcomment -%}

<section class="section newsletter" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="newsletter__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="text-subdued">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm', data-newsletter-form: '' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__form">
          <div class="field">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
            <input type="email" name="contact[email]" id="NewsletterEmail" class="field__input" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          </div>
          <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p data-newsletter-success class="newsletter__success">{{ 'newsletter.confirmation' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="newsletter__success" style="color: var(--color-sale);">{{ form.errors.messages['contact[email]'] }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Únete al club" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Suscríbete y consigue un 10% de descuento en tu primer pedido." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
