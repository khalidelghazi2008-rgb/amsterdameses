{%- comment -%}
  Lifestyle image + text banner. Layout (image left/right) configurable.
{%- endcomment -%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="image-text{% if section.settings.layout == 'right' %} image-text--reverse{% endif %}">
      <div class="image-text__media">
        {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw' %}
      </div>
      <div class="image-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hero__eyebrow" style="color: var(--color-text-subdued);">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen y texto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Texto superior" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Diseñado para durar" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuenta la historia detrás de tu colección o tu marca en un par de frases.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Imagen y texto" }]
}
{% endschema %}
