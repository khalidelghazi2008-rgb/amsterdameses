{% comment %}
  Parallax Showcase (GSAP + ScrollTrigger)
  --------------------------------------------------------------------------
  Versión "tal cual" para Shopify de la landing de scroll AMSTERSHOP SS25:
  cada pieza tiene un panel de imagen que se expande suavemente a pantalla
  completa al hacer scroll, con una capa de número gigante y rayas
  diagonales en parallax. Editable por completo desde el editor de temas
  (bloques "Pieza" y "Frase destacada").

  GSAP, ScrollTrigger y las tipografías de esta sección (Big Shoulders
  Display / Space Mono) solo se cargan en las páginas donde se usa esta
  sección, para no afectar al rendimiento del resto de la tienda. No
  incluye su propia barra de navegación ni footer: usa el header y footer
  reales del tema.
{% endcomment %}

{{ 'component-parallax-showcase.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
>

{%- liquid
  assign panel_blocks = section.blocks | where: 'type', 'panel'
-%}

<div class="parallax-showcase">
  {%- if section.settings.heading != blank -%}
    <div class="parallax-showcase__wrap parallax-showcase__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="parallax-showcase__eyebrow mono">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <div class="parallax-showcase__sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if section.settings.show_scroll_cue and section.settings.scroll_cue_text != blank -%}
        <div class="parallax-showcase__scroll-cue">
          <span class="line"></span> {{ section.settings.scroll_cue_text | escape }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign panel_counter = 0 -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'panel' -%}
        {%- liquid
          assign panel_counter = panel_counter | plus: 1
          assign is_reverse = false
          assign remainder = panel_counter | modulo: 2
          if remainder == 0
            assign is_reverse = true
          endif
          assign padded_index = panel_counter
          if panel_counter < 10
            assign padded_index = '0' | append: panel_counter
          endif
        -%}
        <section
          class="drop parallax-showcase__wrap{% if is_reverse %} drop--reverse{% endif %}"
          {{ block.shopify_attributes }}
          style="--panel-a:{{ block.settings.color_a | default: '#0c1830' }}; --panel-b:{{ block.settings.color_b | default: '#2b4cff' }};"
        >
          <div class="drop__media-stage">
            <div class="drop__media{% if block.settings.image != blank %} drop__media--has-image{% endif %}" data-media>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 74rem, 100vw',
                    widths: '400, 800, 1200, 1600',
                    class: 'drop__media-image'
                }}
              {%- endif -%}
              <div class="drop__stripe" data-parallax data-parallax-speed="0.4"></div>
              <span class="drop__glyph" data-parallax data-parallax-speed="0.15">{{ padded_index }}</span>
              {%- if block.settings.tag_text != blank -%}
                <span class="drop__tag mono">{{ block.settings.tag_text | escape }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="drop__grid">
            <div class="drop__copy">
              {%- if block.settings.eyebrow_label != blank -%}
                <p class="drop__eyebrow">
                  {{ block.settings.eyebrow_label | escape }}
                  {%- if block.settings.eyebrow_detail != blank -%}
                    <span class="mono">— {{ block.settings.eyebrow_detail | escape }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="drop__desc">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- if block.settings.spec_1_value != blank or block.settings.spec_2_value != blank or block.settings.spec_3_value != blank -%}
                <dl class="drop__specs">
                  {%- if block.settings.spec_1_value != blank -%}
                    <div>
                      <dt>{{ block.settings.spec_1_label | escape }}</dt>
                      <dd>{{ block.settings.spec_1_value | escape }}</dd>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.spec_2_value != blank -%}
                    <div>
                      <dt>{{ block.settings.spec_2_label | escape }}</dt>
                      <dd>{{ block.settings.spec_2_value | escape }}</dd>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.spec_3_value != blank -%}
                    <div>
                      <dt>{{ block.settings.spec_3_label | escape }}</dt>
                      <dd class="mono">{{ block.settings.spec_3_value | escape }}</dd>
                    </div>
                  {%- endif -%}
                </dl>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="drop__cta"
                >
                  {{ block.settings.button_label | escape }} →
                </a>
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- when 'statement' -%}
        <div class="parallax-showcase__wrap">
          <section class="parallax-showcase__manifesto" {{ block.shopify_attributes }}>
            <p>{{ block.settings.text }}</p>
          </section>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

{%- if panel_blocks.size > 0 -%}
  {%- comment -%}
    GSAP y ScrollTrigger no se pueden alojar como asset propio del tema
    (son una librería de terceros), así que se cargan desde cdnjs, con
    versión fijada, y solo en las páginas donde se usa esta sección.
  {%- endcomment -%}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"></script>
  <script src="{{ 'parallax-showcase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
