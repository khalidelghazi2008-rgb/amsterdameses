<div id="cta-overlay" style="position:relative; z-index:5; margin-top:{{ section.settings.overlap }}px; display:flex; flex-direction:column; align-items:center; gap:14px; padding:0 16px;">

  {% if section.settings.frase != blank %}
    <div style="background:rgba(13,13,13,0.85); border:2px solid #0057D9; border-radius:10px; padding:16px 24px; text-align:center; box-shadow:0 0 15px rgba(0,87,217,0.5); max-width:700px;">
      <p style="color:#ffffff; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; margin:0; line-height:1.4;">
        {% if section.settings.icono != blank %}{{ section.settings.icono }} {% endif %}{{ section.settings.frase }}
      </p>
    </div>
  {% endif %}

  <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">

    <a href="{{ section.settings.whatsapp_link | default: '#' }}" target="_blank" style="display:flex; align-items:center; gap:8px; background:#25D366; color:#ffffff; padding:12px 18px; border-radius:8px; text-decoration:none; font-weight:700; text-transform:uppercase; font-size:13px; box-shadow:0 2px 8px rgba(0,0,0,0.4);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.5.8 3.1 1.3 4.8 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.5 0-3-.4-4.3-1.1l-.3-.2-3.2.8.9-3.1-.2-.3C4.4 15 4 13.5 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5.1-.1.2-.3.4-.4.1-.1.2-.2.2-.4.1-.2 0-.3 0-.4-.1-.1-.5-1.3-.7-1.7-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9 0 1.1.8 2.2.9 2.4.1.2 1.6 2.4 3.8 3.4.5.2.9.4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z"/></svg>
      Unirme a la comunidad
    </a>

    <a href="{{ section.settings.instagram_link | default: '#' }}" target="_blank" style="display:flex; align-items:center; gap:8px; background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); color:#ffffff; padding:12px 18px; border-radius:8px; text-decoration:none; font-weight:700; text-transform:uppercase; font-size:13px; box-shadow:0 2px 8px rgba(0,0,0,0.4);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.3 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.3-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.3-2.3-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1.1-.4-2.3-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.3-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.3 2.3-.4 1.3-.1 1.7-.1 4.9-.1M12 0C8.7 0 8.3 0 7 .1 5.7.1 4.8.3 4 .6c-.8.3-1.5.7-2.2 1.4C1.1 2.7.7 3.4.4 4.2.1 5 0 5.9 0 7.2 0 8.4 0 8.8 0 12s0 3.6.1 4.8c.1 1.3.2 2.2.5 3 .3.8.7 1.5 1.4 2.2.7.7 1.4 1.1 2.2 1.4.8.3 1.7.4 3 .5C8.4 24 8.8 24 12 24s3.6 0 4.8-.1c1.3-.1 2.2-.2 3-.5.8-.3 1.5-.7 2.2-1.4.7-.7 1.1-1.4 1.4-2.2.3-.8.4-1.7.5-3 .1-1.2.1-1.6.1-4.8s0-3.6-.1-4.8c-.1-1.3-.2-2.2-.5-3-.3-.8-.7-1.5-1.4-2.2-.7-.7-1.4-1.1-2.2-1.4-.8-.3-1.7-.4-3-.5C15.6 0 15.2 0 12 0z"/><circle cx="12" cy="12" r="3.2"/><circle cx="18.4" cy="5.6" r="1.1"/></svg>
      Síguenos en Instagram
    </a>

    <a href="{{ section.settings.tiktok_link | default: '#' }}" target="_blank" style="display:flex; align-items:center; gap:8px; background:#010101; color:#ffffff; padding:12px 18px; border-radius:8px; text-decoration:none; font-weight:700; text-transform:uppercase; font-size:13px; border:1px solid #333; box-shadow:0 2px 8px rgba(0,0,0,0.4);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff"><path d="M16.6 5.8c-1-.7-1.7-1.8-1.9-3.1h-3v13.4c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5c.3 0 .5 0 .8.1v-3.1c-.3 0-.5-.1-.8-.1-3 0-5.5 2.5-5.5 5.5s2.5 5.5 5.5 5.5 5.5-2.5 5.5-5.5V9.2c1.1.8 2.5 1.3 4 1.3V7.5c-.8 0-1.6-.2-2.1-.6z"/></svg>
      Síguenos en TikTok
    </a>

  </div>
</div>

{% schema %}
{
  "name": "CTA sobre banner",
  "settings": [
    { "type": "range", "id": "overlap", "label": "Cuánto sube sobre el banner (px)", "min": 0, "max": 400, "step": 10, "default": 150 },
    { "type": "text", "id": "frase", "label": "Frase de confianza", "default": "Miles de clientes ya confían en nosotros. Compra 100% segura." },
    { "type": "text", "id": "icono", "label": "Emoji delante (opcional)", "default": "✅" },
    { "type": "url", "id": "whatsapp_link", "label": "Enlace de WhatsApp (comunidad)" },
    { "type": "url", "id": "instagram_link", "label": "Enlace de Instagram" },
    { "type": "url", "id": "tiktok_link", "label": "Enlace de TikTok" }
  ],
  "presets": [
    { "name": "CTA sobre banner" }
  ]
}
{% endschema %}