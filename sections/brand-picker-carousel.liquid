{% comment %}
  Selector de marcas: cuadricula fija de 3 por fila (sin carrusel).
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bp-grid">
        {%- for block in section.blocks -%}
          <div class="bp-grid__item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="bp-card">
              <span class="bp-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 90vw', widths: '400, 600, 900, 1200', class: 'bp-card__image' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bp-card__image' }}
                {%- endif -%}
              </span>
              <span class="bp-card__caption">
                {%- if block.settings.title != blank -%}
                  <span class="bp-card__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .bp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media screen and (max-width: 749px) {
    .bp-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .bp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .bp-grid__item {
    margin: 0;
  }

  .bp-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    transform: none !important;
    transition: none !important;
  }

  .bp-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .bp-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: none !important;
    transition: none !important;
  }

  .bp-card__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
  }

  .bp-card__title {
    color: #ffffff !important;
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .bp-card:hover .bp-card__title,
  .bp-card:focus .bp-card__title {
    color: #ffffff !important;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Marcas (grilla 3x3)",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Elige tu marca" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamano del titulo"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio superior", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio inferior", "default": 20 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Marca",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Marca" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    { "name": "Marcas (grilla 3x3)" }
  ]
}
{% endschema %}
