{% comment %}
  Selector de marcas en carrusel: movimiento continuo, arrastrable,
  con estilos propios (sin heredar el hover del tema que oscurece y baja).
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bp-carousel" id="bp-carousel-{{ section.id }}">
        <div class="bp-carousel__track" id="bp-carousel-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="bp-carousel__item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: '#' }}" class="bp-card" draggable="false">
                <span class="bp-card__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '45vw', widths: '400, 600, 900, 1200', class: 'bp-card__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bp-card__image' }}
                  {%- endif -%}
                </span>
                <span class="bp-card__caption">
                  {%- if block.settings.title != blank -%}
                    <span class="bp-card__title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                </span>
              </a>
            </div>
          {%- endfor -%}
          {%- for block in section.blocks -%}
            <div class="bp-carousel__item" aria-hidden="true">
              <a href="{{ block.settings.link | default: '#' }}" class="bp-card" tabindex="-1" draggable="false">
                <span class="bp-card__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '45vw', widths: '400, 600, 900, 1200', class: 'bp-card__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bp-card__image' }}
                  {%- endif -%}
                </span>
                <span class="bp-card__caption">
                  {%- if block.settings.title != blank -%}
                    <span class="bp-card__title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                </span>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #bp-carousel-{{ section.id }} {
    overflow: hidden;
    width: 100%;
    cursor: grab;
  }

  #bp-carousel-{{ section.id }} .bp-carousel__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  #bp-carousel-{{ section.id }} .bp-carousel__item {
    flex: 0 0 auto;
    width: 70vw;
    margin-right: 16px;
    user-select: none;
  }

  @media screen and (min-width: 750px) {
    #bp-carousel-{{ section.id }} .bp-carousel__item {
      width: 32vw;
    }
  }

  .bp-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    transform: none !important;
    transition: none !important;
  }

  .bp-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .bp-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transform: none !important;
    transition: none !important;
  }

  .bp-card__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
  }

  .bp-card__title {
    color: #ffffff !important;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .bp-card:hover .bp-card__title,
  .bp-card:focus .bp-card__title,
  .bp-card:active .bp-card__title {
    color: #ffffff !important;
  }
{%- endstyle -%}

<script>
  (function () {
    const carousel = document.getElementById('bp-carousel-{{ section.id }}');
    const track = document.getElementById('bp-carousel-track-{{ section.id }}');
    if (!carousel || !track) return;

    const totalItems = track.children.length;
    if (totalItems <= 1) return;

    const halfCount = totalItems / 2;
    let position = 0;
    let speed = 0.5;
    let isPaused = false;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartPosition = 0;
    let halfWidth = 0;
    let hasMovedEnough = false;

    function calcHalfWidth() {
      let w = 0;
      for (let i = 0; i < halfCount; i++) {
        w += track.children[i].getBoundingClientRect().width;
        const style = window.getComputedStyle(track.children[i]);
        w += parseFloat(style.marginRight) || 0;
      }
      return w;
    }

    function normalizePosition() {
      if (halfWidth <= 0) return;
      while (position <= -halfWidth) position += halfWidth;
      while (position > 0) position -= halfWidth;
    }

    function render() {
      track.style.transform = 'translateX(' + position + 'px)';
    }

    function loop() {
      if (!isPaused && !isDragging) {
        position -= speed;
        normalizePosition();
        render();
      }
      requestAnimationFrame(loop);
    }

    window.addEventListener('load', function () { halfWidth = calcHalfWidth(); });
    window.addEventListener('resize', function () { halfWidth = calcHalfWidth(); });
    setTimeout(function () { halfWidth = calcHalfWidth(); }, 300);

    carousel.addEventListener('mouseenter', function () { isPaused = true; });
    carousel.addEventListener('mouseleave', function () { isPaused = false; });

    function dragStart(clientX) {
      isDragging = true;
      isPaused = true;
      hasMovedEnough = false;
      dragStartX = clientX;
      dragStartPosition = position;
      carousel.style.cursor = 'grabbing';
    }

    function dragMove(clientX) {
      if (!isDragging) return;
      const delta = clientX - dragStartX;
      if (Math.abs(delta) > 6) { hasMovedEnough = true; }
      position = dragStartPosition + delta;
      normalizePosition();
      render();
    }

    function dragEnd() {
      isDragging = false;
      carousel.style.cursor = 'grab';
    }

    track.addEventListener('click', function (e) {
      if (hasMovedEnough) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    carousel.addEventListener('touchstart', function (e) {
      isPaused = true;
      dragStart(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchmove', function (e) {
      dragMove(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchend', function () {
      dragEnd();
      setTimeout(function () { isPaused = false; }, 800);
    });

    carousel.addEventListener('mousedown', function (e) { dragStart(e.clientX); });
    window.addEventListener('mousemove', function (e) { dragMove(e.clientX); });
    window.addEventListener('mouseup', function () { dragEnd(); });

    requestAnimationFrame(loop);
  })();
</script>

{% schema %}
{
  "name": "Marcas carrusel",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Elige tu marca" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamano del titulo"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio superior", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio inferior", "default": 20 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Marca",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Marca" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    { "name": "Marcas carrusel" }
  ]
}
{% endschema %}
