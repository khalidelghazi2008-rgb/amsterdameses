{%- comment -%}
  Generic "more products" grid pulling from a chosen collection. Reused for
  any merchandising block that needs a plain product grid with quick add.
  4 columns desktop / 2 mobile, lazy-loaded below the fold.
{%- endcomment -%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="section-header__link">{{ 'collection.view_grid' | t }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <div class="grid card-grid card-grid--4">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <p class="empty-state__text">Selecciona una colección en la configuración de esta sección.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Más productos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Más productos" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "label": "Número de productos", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar enlace \"ver todo\"", "default": true }
  ],
  "presets": [{ "name": "Más productos" }]
}
{% endschema %}
