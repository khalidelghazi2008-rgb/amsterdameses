{% comment %}
  Categorías visuales: carrusel de tarjetas grandes, rotación automática lenta,
  se pausa con el cursor, y con flechas para navegar manualmente.
{% endcomment %}

{{ 'section-category-cards.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="category-carousel" id="category-carousel-{{ section.id }}">
        <button type="button" class="category-carousel__arrow category-carousel__arrow--prev" aria-label="Anterior">&#10094;</button>

        <ul class="category-carousel__track list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="category-carousel__item" {{ block.shopify_attributes }}>
              
                href="{{ block.settings.link | default: '#' }}"
                class="category-cards__link{% if block.settings.link == blank %} category-cards__link--disabled{% endif %}"
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true" tabindex="-1"
                {% endif %}
              >
                <span class="category-cards__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        sizes: '90vw',
                        widths: '600, 900, 1200, 1600',
                        class: 'category-cards__image'
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg category-cards__image' }}
                  {%- endif -%}
                </span>
                <span class="category-cards__caption">
                  {%- if block.settings.title != blank -%}
                    <span class="category-cards__title">{{ block.settings.title | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <span class="category-cards__subtitle">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                  <span class="category-cards__cta link animate-arrow">
                    {{ 'amstershop.category_cards.shop_now' | t }}
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <button type="button" class="category-carousel__arrow category-carousel__arrow--next" aria-label="Siguiente">&#10095;</button>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #category-carousel-{{ section.id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  #category-carousel-{{ section.id }} .category-carousel__track {
    display: flex;
    transition: transform 1.2s ease-in-out;
    will-change: transform;
  }

  #category-carousel-{{ section.id }} .category-carousel__item {
    flex: 0 0 70%;
    max-width: 70%;
    margin-right: 20px;
  }

  @media screen and (min-width: 750px) {
    #category-carousel-{{ section.id }} .category-carousel__item {
      flex: 0 0 40%;
      max-width: 40%;
    }
  }

  @media screen and (min-width: 990px) {
    #category-carousel-{{ section.id }} .category-carousel__item {
      flex: 0 0 28%;
      max-width: 28%;
    }
  }

  #category-carousel-{{ section.id }} .category-cards__media {
    aspect-ratio: 3 / 4;
  }

  #category-carousel-{{ section.id }} .category-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0,0,0,0.6);
    color: #ffffff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #category-carousel-{{ section.id }} .category-carousel__arrow:hover {
    background: #0057D9;
  }

  #category-carousel-{{ section.id }} .category-carousel__arrow--prev {
    left: 10px;
  }

  #category-carousel-{{ section.id }} .category-carousel__arrow--next {
    right: 10px;
  }
{%- endstyle -%}

<script>
  (function () {
    const carousel = document.querySelector('#category-carousel-{{ section.id }}');
    const track = carousel ? carousel.querySelector('.category-carousel__track') : null;
    if (!track) return;
    const items = track.children;
    if (items.length <= 1) return;

    const prevBtn = carousel.querySelector('.category-carousel__arrow--prev');
    const nextBtn = carousel.querySelector('.category-carousel__arrow--next');

    let index = 0;
    let timer = null;

    function goTo(newIndex) {
      if (newIndex < 0) {
        newIndex = items.length - 1;
      }
      if (newIndex >= items.length) {
        newIndex = 0;
      }
      index = newIndex;
      const itemWidth = items[0].getBoundingClientRect().width + 20;
      track.style.transform = 'translateX(' + (-itemWidth * index) + 'px)';
    }

    function nextSlide() {
      goTo(index + 1);
    }

    function start() {
      timer = setInterval(nextSlide, 5000);
    }

    function stop() {
      clearInterval(timer);
    }

    start();

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);

    nextBtn.addEventListener('click', function () {
      stop();
      goTo(index + 1);
      start();
    });

    prevBtn.addEventListener('click', function () {
      stop();
      goTo(index - 1);
      start();
    });

    // --- Deslizar con el dedo (swipe) ---
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', function (e) {
      stop();
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carousel.addEventListener('touchend', function (e) {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          goTo(index + 1);
        } else {
          goTo(index - 1);
        }
      }
      start();
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Categorías visuales",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Compra por categoría"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Categoría" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías visuales",
      "blocks": [
        { "type": "category", "settings": { "title": "Hombre" } },
        { "type": "category", "settings": { "title": "Mujer" } },
        { "type": "category", "settings": { "title": "Zapatillas" } },
        { "type": "category", "settings": { "title": "Novedades" } },
        { "type": "category", "settings": { "title": "Ofertas" } }
      ]
    }
  ]
}
{% endschema %}