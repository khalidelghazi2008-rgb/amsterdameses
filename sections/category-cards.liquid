{% comment %}
  Categorías visuales: movimiento continuo, se detiene al tocar y permite
  deslizar manualmente hacia delante/atrás con el dedo mientras está parado.
{% endcomment %}

{{ 'section-category-cards.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="category-carousel" id="category-carousel-{{ section.id }}">
        <div class="category-carousel__track" id="category-carousel-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="category-carousel__item" {{ block.shopify_attributes }}>
              
                href="{{ block.settings.link | default: '#' }}"
                class="category-cards__link{% if block.settings.link == blank %} category-cards__link--disabled{% endif %}"
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true" tabindex="-1"
                {% endif %}
                draggable="false"
              >
                <span class="category-cards__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '90vw', widths: '600, 900, 1200, 1600', class: 'category-cards__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg category-cards__image' }}
                  {%- endif -%}
                </span>
                <span class="category-cards__caption">
                  {%- if block.settings.title != blank -%}<span class="category-cards__title">{{ block.settings.title | escape }}</span>{%- endif -%}
                  {%- if block.settings.subtitle != blank -%}<span class="category-cards__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
                  <span class="category-cards__cta link animate-arrow">{{ 'amstershop.category_cards.shop_now' | t }}{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </span>
              </a>
            </div>
          {%- endfor -%}
          {%- for block in section.blocks -%}
            <div class="category-carousel__item" aria-hidden="true">
              <a href="{{ block.settings.link | default: '#' }}" class="category-cards__link{% if block.settings.link == blank %} category-cards__link--disabled{% endif %}" tabindex="-1" draggable="false">
                <span class="category-cards__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '90vw', widths: '600, 900, 1200, 1600', class: 'category-cards__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg category-cards__image' }}
                  {%- endif -%}
                </span>
                <span class="category-cards__caption">
                  {%- if block.settings.title != blank -%}<span class="category-cards__title">{{ block.settings.title | escape }}</span>{%- endif -%}
                  {%- if block.settings.subtitle != blank -%}<span class="category-cards__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
                  <span class="category-cards__cta link animate-arrow">{{ 'amstershop.category_cards.shop_now' | t }}{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </span>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #category-carousel-{{ section.id }} {
    overflow: hidden;
    width: 100%;
    cursor: grab;
  }

  #category-carousel-{{ section.id }} .category-carousel__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  #category-carousel-{{ section.id }} .category-carousel__item {
    flex: 0 0 auto;
    width: 58vw;
    margin-right: 16px;
    user-select: none;
  }

  @media screen and (min-width: 750px) {
    #category-carousel-{{ section.id }} .category-carousel__item {
      width: 34vw;
    }
  }

  @media screen and (min-width: 990px) {
    #category-carousel-{{ section.id }} .category-carousel__item {
      width: 22vw;
    }
  }

  #category-carousel-{{ section.id }} .category-cards__media {
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
  }

  #category-carousel-{{ section.id }} .category-cards__image {
    border-radius: 16px;
    pointer-events: none;
  }
{%- endstyle -%}

<script>
  (function () {
    const carousel = document.getElementById('category-carousel-{{ section.id }}');
    const track = document.getElementById('category-carousel-track-{{ section.id }}');
    if (!carousel || !track) return;

    const totalItems = track.children.length;
    if (totalItems <= 1) return;

    const halfCount = totalItems / 2;
    let position = 0;
    let speed = 0.6;
    let isPaused = false;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartPosition = 0;
    let halfWidth = 0;

    function calcHalfWidth() {
      let w = 0;
      for (let i = 0; i < halfCount; i++) {
        w += track.children[i].getBoundingClientRect().width;
        const style = window.getComputedStyle(track.children[i]);
        w += parseFloat(style.marginRight) || 0;
      }
      return w;
    }

    function normalizePosition() {
      if (halfWidth <= 0) return;
      while (position <= -halfWidth) position += halfWidth;
      while (position > 0) position -= halfWidth;
    }

    function render() {
      track.style.transform = 'translateX(' + position + 'px)';
    }

    function loop() {
      if (!isPaused && !isDragging) {
        position -= speed;
        normalizePosition();
        render();
      }
      requestAnimationFrame(loop);
    }

    window.addEventListener('load', function () {
      halfWidth = calcHalfWidth();
    });
    window.addEventListener('resize', function () {
      halfWidth = calcHalfWidth();
    });
    setTimeout(function () { halfWidth = calcHalfWidth(); }, 300);

    carousel.addEventListener('mouseenter', function () { isPaused = true; });
    carousel.addEventListener('mouseleave', function () { isPaused = false; });

    function dragStart(clientX) {
      isDragging = true;
      isPaused = true;
      dragStartX = clientX;
      dragStartPosition = position;
      carousel.style.cursor = 'grabbing';
    }

    function dragMove(clientX) {
      if (!isDragging) return;
      const delta = clientX - dragStartX;
      position = dragStartPosition + delta;
      normalizePosition();
      render();
    }

    function dragEnd() {
      isDragging = false;
      carousel.style.cursor = 'grab';
    }

    carousel.addEventListener('touchstart', function (e) {
      isPaused = true;
      dragStart(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchmove', function (e) {
      dragMove(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchend', function () {
      dragEnd();
      setTimeout(function () { isPaused = false; }, 800);
    });

    carousel.addEventListener('mousedown', function (e) {
      dragStart(e.clientX);
    });
    window.addEventListener('mousemove', function (e) {
      dragMove(e.clientX);
    });
    window.addEventListener('mouseup', function () {
      dragEnd();
    });

    requestAnimationFrame(loop);
  })();
</script>

{% schema %}
{
  "name": "Categorías visuales",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Compra por categoría"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Categoría" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías visuales",
      "blocks": [
        { "type": "category", "settings": { "title": "Hombre" } },
        { "type": "category", "settings": { "title": "Mujer" } },
        { "type": "category", "settings": { "title": "Zapatillas" } },
        { "type": "category", "settings": { "title": "Novedades" } },
        { "type": "category", "settings": { "title": "Ofertas" } }
      ]
    }
  ]
}
{% endschema %}