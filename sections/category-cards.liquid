{% comment %}
  Categorias visuales: cuadricula fija de 3 por fila, sin carrusel.
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cv-grid">
        {%- for block in section.blocks -%}
          <div class="cv-grid__item" {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="cv-card"
              {% if block.settings.link == blank %}role="link" aria-disabled="true" tabindex="-1"{% endif %}
            >
              <span class="cv-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 90vw', widths: '400, 600, 900, 1200', class: 'cv-card__image' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg cv-card__image' }}
                {%- endif -%}
              </span>
              <span class="cv-card__caption">
                {%- if block.settings.title != blank -%}<span class="cv-card__title">{{ block.settings.title | escape }}</span>{%- endif -%}
                {%- if block.settings.subtitle != blank -%}<span class="cv-card__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
              </span>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media screen and (max-width: 749px) {
    .cv-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .cv-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cv-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .cv-card__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .cv-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cv-card__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cv-card__title {
    color: #ffffff !important;
    font-size: 17px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-card__subtitle {
    color: #ffffff !important;
    font-size: 12px;
    opacity: 0.9;
  }

  .cv-card:hover .cv-card__title,
  .cv-card:focus .cv-card__title,
  .cv-card:hover .cv-card__subtitle,
  .cv-card:focus .cv-card__subtitle {
    color: #ffffff !important;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Categorias visuales",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Compra por categoria" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Categoria" },
        { "type": "text", "id": "subtitle", "label": "Subtitulo (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias visuales",
      "blocks": [
        { "type": "category", "settings": { "title": "Hombre" } },
        { "type": "category", "settings": { "title": "Mujer" } },
        { "type": "category", "settings": { "title": "Zapatillas" } },
        { "type": "category", "settings": { "title": "Novedades" } },
        { "type": "category", "settings": { "title": "Ofertas" } }
      ]
    }
  ]
}
{% endschema %}
