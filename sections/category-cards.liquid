{% comment %}
  Categorías visuales: tarjetas grandes con imagen a pantalla completa
  (ej. HOMBRE / MUJER / ZAPATILLAS / NOVEDADES / OFERTAS). Cada tarjeta es
  un bloque "category" 100% configurable desde el editor (imagen, título,
  subtítulo opcional y enlace) — nada va hardcodeado en el código.
{% endcomment %}

{{ 'section-category-cards.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="category-cards category-cards--{{ section.settings.columns_desktop }}-col list-unstyled"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="category-cards__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="category-cards__link{% if block.settings.link == blank %} category-cards__link--disabled{% endif %}"
              {% if block.settings.link == blank %}
                role="link" aria-disabled="true" tabindex="-1"
              {% endif %}
            >
              <span class="category-cards__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      widths: '400, 600, 800, 1000, 1200',
                      class: 'category-cards__image'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg category-cards__image' }}
                {%- endif -%}
              </span>
              <span class="category-cards__caption">
                {%- if block.settings.title != blank -%}
                  <span class="category-cards__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="category-cards__subtitle">{{ block.settings.subtitle | escape }}</span>
                {%- endif -%}
                <span class="category-cards__cta link animate-arrow">
                  {{ 'amstershop.category_cards.shop_now' | t }}
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Categorías visuales",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Compra por categoría"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "Columnas en escritorio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoría"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo (opcional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías visuales",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Hombre"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Mujer"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Zapatillas"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Novedades"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Ofertas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
