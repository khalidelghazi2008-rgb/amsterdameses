{% comment %}
  Categorias visuales: movimiento continuo, arrastrable, estilos propios
  (sin heredar el hover del tema que oscurece el texto y desplaza la tarjeta).
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title amstershop-title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cv-carousel" id="cv-carousel-{{ section.id }}">
        <div class="cv-carousel__track" id="cv-carousel-track-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="cv-carousel__item" {{ block.shopify_attributes }}>
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="cv-card"
                {% if block.settings.link == blank %}role="link" aria-disabled="true" tabindex="-1"{% endif %}
                draggable="false"
              >
                <span class="cv-card__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '90vw', widths: '600, 900, 1200, 1600', class: 'cv-card__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg cv-card__image' }}
                  {%- endif -%}
                </span>
                <span class="cv-card__caption">
                  {%- if block.settings.title != blank -%}<span class="cv-card__title">{{ block.settings.title | escape }}</span>{%- endif -%}
                  {%- if block.settings.subtitle != blank -%}<span class="cv-card__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
                </span>
              </a>
            </div>
          {%- endfor -%}
          {%- for block in section.blocks -%}
            <div class="cv-carousel__item" aria-hidden="true">
              <a href="{{ block.settings.link | default: '#' }}" class="cv-card" tabindex="-1" draggable="false">
                <span class="cv-card__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '90vw', widths: '600, 900, 1200, 1600', class: 'cv-card__image', draggable: false }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg cv-card__image' }}
                  {%- endif -%}
                </span>
                <span class="cv-card__caption">
                  {%- if block.settings.title != blank -%}<span class="cv-card__title">{{ block.settings.title | escape }}</span>{%- endif -%}
                  {%- if block.settings.subtitle != blank -%}<span class="cv-card__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
                </span>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #cv-carousel-{{ section.id }} {
    overflow: hidden;
    width: 100%;
    cursor: grab;
  }

  #cv-carousel-{{ section.id }} .cv-carousel__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  #cv-carousel-{{ section.id }} .cv-carousel__item {
    flex: 0 0 auto;
    width: 58vw;
    margin-right: 16px;
    user-select: none;
  }

  @media screen and (min-width: 750px) {
    #cv-carousel-{{ section.id }} .cv-carousel__item {
      width: 34vw;
    }
  }

  @media screen and (min-width: 990px) {
    #cv-carousel-{{ section.id }} .cv-carousel__item {
      width: 22vw;
    }
  }

  .cv-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    transform: none !important;
    transition: none !important;
  }

  .cv-card__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 16px;
  }

  .cv-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
    pointer-events: none;
    transform: none !important;
    transition: none !important;
  }

  .cv-card__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cv-card__title {
    color: #ffffff !important;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cv-card__subtitle {
    color: #ffffff !important;
    font-size: 13px;
    opacity: 0.85;
  }

  .cv-card:hover .cv-card__title,
  .cv-card:focus .cv-card__title,
  .cv-card:active .cv-card__title,
  .cv-card:hover .cv-card__subtitle,
  .cv-card:focus .cv-card__subtitle {
    color: #ffffff !important;
  }
{%- endstyle -%}

<script>
  (function () {
    const carousel = document.getElementById('cv-carousel-{{ section.id }}');
    const track = document.getElementById('cv-carousel-track-{{ section.id }}');
    if (!carousel || !track) return;

    const totalItems = track.children.length;
    if (totalItems <= 1) return;

    const halfCount = totalItems / 2;
    let position = 0;
    let speed = 0.6;
    let isPaused = false;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartPosition = 0;
    let halfWidth = 0;
    let hasMovedEnough = false;

    function calcHalfWidth() {
      let w = 0;
      for (let i = 0; i < halfCount; i++) {
        w += track.children[i].getBoundingClientRect().width;
        const style = window.getComputedStyle(track.children[i]);
        w += parseFloat(style.marginRight) || 0;
      }
      return w;
    }

    function normalizePosition() {
      if (halfWidth <= 0) return;
      while (position <= -halfWidth) position += halfWidth;
      while (position > 0) position -= halfWidth;
    }

    function render() {
      track.style.transform = 'translateX(' + position + 'px)';
    }

    function loop() {
      if (!isPaused && !isDragging) {
        position -= speed;
        normalizePosition();
        render();
      }
      requestAnimationFrame(loop);
    }

    window.addEventListener('load', function () { halfWidth = calcHalfWidth(); });
    window.addEventListener('resize', function () { halfWidth = calcHalfWidth(); });
    setTimeout(function () { halfWidth = calcHalfWidth(); }, 300);

    carousel.addEventListener('mouseenter', function () { isPaused = true; });
    carousel.addEventListener('mouseleave', function () { isPaused = false; });

    function dragStart(clientX) {
      isDragging = true;
      isPaused = true;
      hasMovedEnough = false;
      dragStartX = clientX;
      dragStartPosition = position;
      carousel.style.cursor = 'grabbing';
    }

    function dragMove(clientX) {
      if (!isDragging) return;
      const delta = clientX - dragStartX;
      if (Math.abs(delta) > 6) { hasMovedEnough = true; }
      position = dragStartPosition + delta;
      normalizePosition();
      render();
    }

    function dragEnd() {
      isDragging = false;
      carousel.style.cursor = 'grab';
    }

    track.addEventListener('click', function (e) {
      if (hasMovedEnough) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    carousel.addEventListener('touchstart', function (e) {
      isPaused = true;
      dragStart(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchmove', function (e) {
      dragMove(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchend', function () {
      dragEnd();
      setTimeout(function () { isPaused = false; }, 800);
    });

    carousel.addEventListener('mousedown', function (e) { dragStart(e.clientX); });
    window.addEventListener('mousemove', function (e) { dragMove(e.clientX); });
    window.addEventListener('mouseup', function () { dragEnd(); });

    requestAnimationFrame(loop);
  })();
</script>

{% schema %}
{
  "name": "Categorias visuales",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Compra por categoria" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Categoria" },
        { "type": "text", "id": "subtitle", "label": "Subtitulo (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias visuales",
      "blocks": [
        { "type": "category", "settings": { "title": "Hombre" } },
        { "type": "category", "settings": { "title": "Mujer" } },
        { "type": "category", "settings": { "title": "Zapatillas" } },
        { "type": "category", "settings": { "title": "Novedades" } },
        { "type": "category", "settings": { "title": "Ofertas" } }
      ]
    }
  ]
}
{% endschema %}
