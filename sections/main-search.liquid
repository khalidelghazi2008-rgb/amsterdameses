{%- comment -%}
  Full search results page. Mixed result types (products / pages / articles)
  each render with an appropriate card. Falls back to a friendly empty state.
{%- endcomment -%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:520px;margin-bottom:2rem;">
      <div class="field" style="display:flex;gap:.5rem;">
        <label class="visually-hidden" for="SearchPageInput">{{ 'general.search.search' | t }}</label>
        <input type="search" name="q" id="SearchPageInput" class="field__input" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        <input type="hidden" name="type" value="{{ search.types | join: ',' }}">
        <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          {% render 'icon', name: 'search', class: 'empty-state__icon' %}
          <p class="empty-state__title">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          <p class="empty-state__text">{{ 'general.search.no_results_helper' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <p class="collection-toolbar__count" style="margin-bottom:1.5rem;">{{ 'general.search.results_for' | t: terms: search.terms }} &mdash; {{ search.results_count }}</p>

        {%- paginate search.results by 24 -%}
          <div class="grid card-grid card-grid--4">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a href="{{ item.url }}" class="collection-card">
                    {%- if item.image or item.featured_image -%}
                      {% render 'responsive-image', image: item.image | default: item.featured_image, class: 'collection-card__image', sizes: '25vw' %}
                    {%- endif -%}
                    <div class="collection-card__overlay"></div>
                    <h3 class="collection-card__title">{{ item.title }}</h3>
                  </a>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span aria-current="page">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <p class="empty-state__text">{{ 'general.search.placeholder' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Página de búsqueda"
}
{% endschema %}
