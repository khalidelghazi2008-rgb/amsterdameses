{% comment %}
  "Vistos recientemente": pinta en el cliente (localStorage) los últimos
  productos visitados, excluyendo el producto de la página actual. Se
  oculta automáticamente si no hay ningún producto que mostrar todavía.
{% endcomment %}

{{ 'amstershop-js-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'amstershop-client-cards.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

<div
  class="color-{{ section.settings.color_scheme }} gradient"
  data-amstershop-recently-viewed
  data-current-product-handle="{{ product.handle }}"
  data-max-products="{{ section.settings.max_products }}"
  hidden
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="title-wrapper-with-link title-wrapper--no-top-margin">
      <h2 class="title amstershop-title {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    </div>
    <ul class="amstershop-js-card-grid" role="list"></ul>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Vistos recientemente",
  "class": "section",
  "enabled_on": {
    "templates": ["product", "collection", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Vistos recientemente"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Nº máximo de productos"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Vistos recientemente"
    }
  ]
}
{% endschema %}
