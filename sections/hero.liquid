{%- comment -%}
  Full-width hero banner with separate desktop/mobile art direction, overlay,
  configurable content position and up to two CTAs. Optional trust strip
  (stat blocks: orders shipped, years in business, etc.) renders underneath.
{%- endcomment -%}

<section class="hero" {{ section.shopify_attributes }}>
  <div class="hero__media" style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    {%- if section.settings.image_mobile != blank -%}
      {% render 'responsive-image', image: section.settings.image_mobile, class: 'hero__media--mobile', sizes: '100vw', loading: 'eager', fetchpriority: 'high' %}
    {%- elsif section.settings.image_desktop != blank -%}
      {% render 'responsive-image', image: section.settings.image_desktop, class: 'hero__media--mobile', sizes: '100vw', loading: 'eager', fetchpriority: 'high' %}
    {%- else -%}
      <div class="hero__media--mobile" style="background: var(--color-surface); position:absolute; inset:0;"></div>
    {%- endif -%}

    {%- if section.settings.image_desktop != blank -%}
      {% render 'responsive-image', image: section.settings.image_desktop, class: 'hero__media--desktop', sizes: '100vw', loading: 'eager', fetchpriority: 'high' %}
    {%- endif -%}

    {%- if section.settings.show_overlay -%}<div class="hero__overlay"></div>{%- endif -%}

    <div class="hero__content hero__content--{{ section.settings.content_position }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__ctas">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--outline" style="color:#fff;border-color:#fff;">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_stats and section.blocks.size > 0 -%}
  <div class="trust-strip section--tight" {{ section.shopify_attributes }}>
    <div class="page-width">
      <div class="trust-strip__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="trust-strip__stat" {{ block.shopify_attributes }}>
              <p class="trust-strip__stat-number">{{ block.settings.number }}</p>
              <p class="trust-strip__stat-label">{{ block.settings.label }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Imagen (escritorio)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen (móvil)", "info": "Si se deja vacía, se usa la imagen de escritorio." },
    { "type": "text", "id": "eyebrow", "label": "Texto superior" },
    { "type": "text", "id": "heading", "label": "Título", "default": "ESTILO QUE MARCA LA DIFERENCIA" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Descubre las últimas novedades de la temporada." },
    { "type": "text", "id": "button_label", "label": "Texto botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace botón principal" },
    { "type": "text", "id": "button_label_2", "label": "Texto botón secundario" },
    { "type": "url", "id": "button_link_2", "label": "Enlace botón secundario" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posición del contenido",
      "options": [
        { "value": "bottom-left", "label": "Abajo izquierda" },
        { "value": "bottom-center", "label": "Abajo centro" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "bottom-left"
    },
    { "type": "checkbox", "id": "show_overlay", "label": "Mostrar capa oscura", "default": true },
    { "type": "range", "id": "overlay_opacity", "label": "Opacidad de la capa", "min": 0, "max": 80, "step": 5, "default": 25, "unit": "%" },
    { "type": "checkbox", "id": "show_stats", "label": "Mostrar bloque de confianza (estadísticas)", "default": false }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "50.000+" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "Pedidos entregados" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "stat", "settings": { "number": "50.000+", "label": "Pedidos entregados" } },
        { "type": "stat", "settings": { "number": "10 años", "label": "De experiencia" } },
        { "type": "stat", "settings": { "number": "4.8/5", "label": "Valoración media" } }
      ]
    }
  ]
}
{% endschema %}
