{%- comment -%}
  Renders a price block with regular / sale price and discount %.
  Accepts:
    product   {Object} - product (optional if variant passed)
    variant   {Object} - specific variant (defaults to product.selected_or_first_available_variant)
    show_discount {Boolean} - show "-XX%" badge next to price
{%- endcomment -%}

{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare_at = target.compare_at_price
  assign current = target.price
  assign on_sale = false
  if compare_at > current
    assign on_sale = true
  endif
-%}

<span class="price{% if on_sale %} price--on-sale{% endif %}" data-product-price>
  {%- if on_sale -%}
    <span class="price__regular"><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span><span class="money">{{ compare_at | money }}</span></span>
    <span class="price__sale"><span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span><span class="money">{{ current | money }}</span></span>
    {%- if show_discount -%}
      {%- assign discount_percent = compare_at | minus: current | times: 100 | divided_by: compare_at -%}
      <span class="price__discount-percent" data-discount-percent>-{{ discount_percent }}%</span>
    {%- endif -%}
  {%- else -%}
    <span class="price__regular"><span class="money">{{ current | money }}</span></span>
  {%- endif -%}
</span>
