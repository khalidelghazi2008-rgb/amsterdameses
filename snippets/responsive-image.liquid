{%- comment -%}
  Renders a responsive, lazy-loadable <img> with srcset/sizes and explicit
  width/height to avoid layout shift.

  Accepts:
    image           {Object}  - Shopify image object (required)
    aspect_ratio    {String}  - CSS aspect-ratio value, e.g. "3/4" (optional)
    sizes           {String}  - sizes attribute (default: 100vw)
    widths          {String}  - comma list of widths (default a sensible set)
    class           {String}  - class(es) for the <img>
    alt             {String}  - alt override
    loading         {String}  - "lazy" (default) or "eager"
    fetchpriority   {String}  - "high" | "low" | "auto"
{%- endcomment -%}

{%- liquid
  assign img_widths = widths | default: '360,540,720,900,1080,1296,1512,1800'
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_alt = alt | default: image.alt | escape
-%}

{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 720 }}"
    srcset="{% for w in img_widths | split: ',' %}{{ image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
    sizes="{{ img_sizes }}"
    alt="{{ img_alt }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ img_loading }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    class="{{ class }}"
    {% if aspect_ratio %}style="aspect-ratio: {{ aspect_ratio }}; object-fit: cover;"{% endif %}
  >
{%- else -%}
  <div class="{{ class }} placeholder-image" style="aspect-ratio: {{ aspect_ratio | default: '3/4' }}; background: var(--color-surface);" role="img" aria-label="{{ img_alt }}"></div>
{%- endif -%}
