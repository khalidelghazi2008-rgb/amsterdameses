{%- comment -%}
  Cart drawer: slide-in panel with AJAX-updated line items, free shipping
  progress bar, subtotal and checkout CTA. Rendered once in layout/theme.liquid
  so it's available on every page. Re-synced client-side by assets/theme.js
  (#CartDrawer-content is the swap target after any /cart/add.js or
  /cart/change.js call).
{%- endcomment -%}

<div id="CartDrawer" class="drawer drawer--right" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ 'general.cart.title' | t }}" hidden>
  <div id="CartDrawer-content">
    <div class="drawer__header">
      <h2 class="drawer__title">{{ 'general.cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="drawer__body">
      {%- if settings.cart_show_shipping_note and settings.cart_shipping_note != blank -%}
        {%- assign threshold_cents = settings.cart_free_shipping_threshold | times: 100 -%}
        {%- assign remaining = threshold_cents | minus: cart.total_price -%}
        <div class="free-shipping-bar" data-free-shipping-bar data-threshold="{{ threshold_cents }}">
          <p class="free-shipping-bar__text"
             data-reached-text="{{ 'general.cart.free_shipping_reached' | t }}"
             data-remaining-template="{{ 'general.cart.free_shipping_remaining' | t }}">
            {%- if remaining > 0 -%}
              {{ 'general.cart.free_shipping_remaining' | t: amount: remaining | money }}
            {%- else -%}
              {{ 'general.cart.free_shipping_reached' | t }}
            {%- endif -%}
          </p>
          <div class="free-shipping-bar__track">
            <div class="free-shipping-bar__fill" style="width: {{ cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100 }}%;"></div>
          </div>
        </div>
      {%- endif -%}

      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p class="empty-state__title">{{ 'general.cart.empty' | t }}</p>
          <p class="empty-state__text">{{ 'general.cart.empty_helper' | t }}</p>
          <button type="button" class="button" data-drawer-close>{{ 'general.cart.start_shopping' | t }}</button>
        </div>
      {%- else -%}
        <ul class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line-item">
              <a href="{{ item.url }}">
                <img
                  class="cart-line-item__image"
                  src="{{ item.image | image_url: width: 180 }}"
                  alt="{{ item.image.alt | escape }}"
                  width="90" height="112" loading="lazy"
                >
              </a>
              <div class="cart-line-item__details">
                <a href="{{ item.url }}" class="cart-line-item__title">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <p class="cart-line-item__variant">{{ item.variant.title }}</p>
                {%- endif -%}
                <div class="cart-line-item__price-mobile">{% render 'price', variant: item.variant %}</div>
                <button type="button" class="cart-line-item__remove" data-cart-remove data-line="{{ forloop.index }}">
                  {{ 'general.cart.remove' | t }}
                </button>
              </div>
              <div class="cart-line-item__qty-price">
                {% render 'price', variant: item.variant %}
                {% render 'quantity-selector', id: 'drawer-line-' | append: forloop.index, quantity: item.quantity, line: forloop.index %}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__footer">
        <div class="cart-summary__row cart-summary__total">
          <span>{{ 'general.cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-subdued" style="font-size:.78rem;margin-bottom:1rem;">{{ 'general.cart.shipping_at_checkout' | t }}</p>
        <a href="{{ routes.cart_url }}" class="button button--secondary button--full" style="margin-bottom:.6rem;">
          {{ 'general.cart.view_cart' | t: count: cart.item_count }}
        </a>
        <a href="{{ routes.cart_url }}/checkout" class="button button--full">
          {{ 'general.cart.checkout' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<div class="drawer-overlay" data-drawer-overlay="CartDrawer"></div>
