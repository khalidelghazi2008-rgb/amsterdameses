{%- comment -%}
  Renders breadcrumb navigation + BreadcrumbList JSON-LD.
{%- endcomment -%}

<nav class="breadcrumbs" aria-label="breadcrumb">
  <a href="{{ routes.root_url }}">{{ shop.name }}</a>
  <span class="breadcrumbs__sep" aria-hidden="true">/</span>

  {%- if template contains 'product' -%}
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>

  {%- elsif template contains 'collection' -%}
    <a href="{{ routes.all_products_collection_url }}">{{ 'collection.title' | t }}</a>
    <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    <span aria-current="page">{{ collection.title }}</span>

  {%- elsif template contains 'page' -%}
    <span aria-current="page">{{ page.title }}</span>

  {%- elsif template contains 'blog' or template contains 'article' -%}
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    {%- if article -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ article.title }}</span>
    {%- endif -%}
  {%- endif -%}
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ shop.name | json }},
      "item": {{ shop.url | append: routes.root_url | json }}
    }
    {%- if template contains 'product' and collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ shop.url | append: product.url | json }}
    }
    {%- elsif template contains 'product' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ shop.url | append: product.url | json }}
    }
    {%- elsif template contains 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    }
    {%- endif -%}
  ]
}
</script>
