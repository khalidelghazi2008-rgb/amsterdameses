{%- comment -%}
  Renders Shopify's native collection filters (collection.filters, powered
  by Search & Discovery). Shared by the desktop sidebar and the mobile
  filters drawer in sections/main-collection.liquid.
  Accepts: results {Object} - a collection or search results object.
{%- endcomment -%}

{%- liquid
  assign has_active_filters = false
  for filter in results.filters
    if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
      assign has_active_filters = true
    endif
  endfor
-%}

<div id="FacetFiltersForm-{{ results.url | handleize }}">
  {%- if has_active_filters -%}
    <div class="filters__active">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <span class="filters__active-pill">
            {{ value.label }}
            <a href="{{ value.url_to_remove }}" aria-label="{{ 'collection.filters.clear' | t }} {{ value.label }}">{% render 'icon', name: 'close', class: 'icon' %}</a>
          </span>
        {%- endfor -%}
      {%- endfor -%}
      <a href="{{ results.url }}" class="filters__clear">{{ 'collection.filters.clear_all' | t }}</a>
    </div>
  {%- endif -%}

  {%- for filter in results.filters -%}
    <div class="filters__group">
      <p class="filters__group-title">{{ filter.label }}</p>

      {%- case filter.type -%}
        {%- when 'list' -%}
          {%- for value in filter.values -%}
            <label class="filters__option">
              <input
                type="checkbox"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                {% if value.active %}checked{% endif %}
                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                onchange="window.location.href = this.checked ? '{{ value.url_to_add }}' : '{{ value.url_to_remove }}'"
              >
              {{ value.label }} ({{ value.count }})
            </label>
          {%- endfor -%}

        {%- when 'boolean' -%}
          {%- for value in filter.values -%}
            <label class="filters__option">
              <input
                type="checkbox"
                {% if value.active %}checked{% endif %}
                onchange="window.location.href = this.checked ? '{{ value.url_to_add }}' : '{{ value.url_to_remove }}'"
              >
              {{ value.label }} ({{ value.count }})
            </label>
          {%- endfor -%}

        {%- when 'price_range' -%}
          <form action="{{ results.url }}" method="get" class="filters__price-range">
            <input type="hidden" name="sort_by" value="{{ results.sort_by }}">
            <input
              type="number"
              name="{{ filter.min_value.param_name }}"
              placeholder="{{ 'collection.filters.from' | t }}"
              value="{{ filter.min_value.value }}"
              class="field__input"
              min="0"
            >
            <span>&ndash;</span>
            <input
              type="number"
              name="{{ filter.max_value.param_name }}"
              placeholder="{{ 'collection.filters.to' | t }}"
              value="{{ filter.max_value.value }}"
              class="field__input"
              min="0"
            >
            <button type="submit" class="button button--small button--secondary">{{ 'collection.filters.apply' | t }}</button>
          </form>
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>
